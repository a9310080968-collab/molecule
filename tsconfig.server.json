{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "isolatedModules": false,
    "noEmit": false,
    "outDir": "dist-server",
    "rootDir": "server"
  },
  "include": ["server/**/*.ts"]
}

# Browser: "demo" preserves the public presentation, "pilot" requires API login.
VITE_APP_MODE=pilot

NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATABASE_URL=postgresql://molecule:change-me-local-only@127.0.0.1:5432/molecule
DATABASE_SSL=false
CORS_ORIGIN=http://127.0.0.1:5173,http://localhost:5173
SESSION_COOKIE_NAME=molecule_session
SESSION_TTL_HOURS=12

# Used only by docker compose for the local PostgreSQL container.
POSTGRES_PASSWORD=change-me-local-only
